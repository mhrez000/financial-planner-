# SQLite for local development. Swap the provider in prisma/schema.prisma to
# "postgresql" and point DATABASE_URL at Postgres for staging/production —
# the schema is written to be portable (integer cents, no SQLite-only types).
DATABASE_URL="file:./dev.db"

# Signs session cookies. Any long random string; required whenever
# NODE_ENV=production (including local `npm run start`).
# Generate one: openssl rand -hex 32
SESSION_SECRET="dev-only-secret-change-me"
